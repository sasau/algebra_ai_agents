# --- Gradle (Java track) ---
.gradle/
# The wrapper jar MUST be committed: it is what lets a student run ./gradlew
# without installing Gradle first. Re-listed explicitly so no broader rule
# above can ever swallow it.
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# --- logs & caches ---
npm-debug.log*
yarn-error.log*
.npm/
.cache/

