# Copy this file to .env and paste your real key.
#
#     cp .env.example .env
#
# ONE key file for the whole practice. Both tracks read this exact file:
#   ts/   — via src/env.ts        (dotenv, path "../.env")
#   java/ — via Client.java       (dotenv-java, directory "..")
#
# .env is in .gitignore. Never commit the real key.
# Get a key from: https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
